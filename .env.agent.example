# Append these to your existing .env (never commit .env).
# --- LLM: local Llama 3.1 through Ollama (default) ---
LLM_PROVIDER=ollama            # ollama | groq | bedrock | none
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=4096          # context window; Ollama's own default (2048) truncates the report prompt
# OLLAMA_KEEP_ALIVE=30m        # keep the model in memory between requests
# OLLAMA_TIMEOUT=180           # seconds; the first request loads the model and is slow
#
# Other providers (only used if LLM_PROVIDER is changed). Do NOT add a second GROQ_API_KEY line: the last one wins.
# GROQ_MODEL=llama-3.3-70b-versatile
# BEDROCK_MODEL_ID=            # required when LLM_PROVIDER=bedrock (a model enabled in your AWS account)
# AWS_REGION=ap-south-1

# --- RAG ---
EMBEDDINGS_PROVIDER=huggingface   # huggingface | bedrock | hashing (tests only)
# POLICY_S3_BUCKET=               # load policies from S3 at startup instead of the image
# POLICY_S3_PREFIX=policies/

# --- Agent behaviour ---
REVIEW_THRESHOLD=0.75        # weighted score at/above which a human must review
# LANGGRAPH_POSTGRES_URL=postgresql://user:pass@host:5432/db   # durable human-review state
