# Append these to your existing .env (never commit .env).
# --- LLM ---
# Your existing GROQ_API_KEY in .env is reused. Do NOT add a second GROQ_API_KEY line: the last one wins.
LLM_PROVIDER=groq            # groq | bedrock | none
# GROQ_MODEL=llama-3.3-70b-versatile
# BEDROCK_MODEL_ID=          # required when LLM_PROVIDER=bedrock (a model you have enabled in your AWS account)
# AWS_REGION=ap-south-1

# --- RAG ---
EMBEDDINGS_PROVIDER=huggingface   # huggingface | bedrock | hashing (tests only)
# POLICY_S3_BUCKET=               # load policies from S3 at startup instead of the image
# POLICY_S3_PREFIX=policies/

# --- Agent behaviour ---
REVIEW_THRESHOLD=0.75        # weighted score at/above which a human must review
# LANGGRAPH_POSTGRES_URL=postgresql://user:pass@host:5432/db   # durable human-review state
